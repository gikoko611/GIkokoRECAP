<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070D">

    <!-- Cyber 3D animated background -->
    <com.gikoko.recap.CyberSplashView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Home screen logo (download (4).jpeg နဲ့ အစားထိုးနိုင် — README ကြည့်ပါ) -->
        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:src="@drawable/ic_monogram"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/splash_title"
            android:textColor="#F5B301"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.18"
            android:shadowColor="#F5B301"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="14" />

        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/splash_subtitle"
            android:textColor="#B8C4D4"
            android:textSize="13sp"
            android:letterSpacing="0.25" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/splash_tagline"
            android:textColor="#66F5B301"
            android:textSize="11sp"
            android:letterSpacing="0.3" />
    </LinearLayout>
</FrameLayout>
